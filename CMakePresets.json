{
  "version": 6,
  "configurePresets": [
    {
      "name": "_esp32",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "DSIG_ESP32": "ON",
        "IDF_TARGET": "esp32",
        "SDKCONFIG": "${sourceDir}/build/${presetName}/sdkconfig"
      }
    },
    {
      "name": "esp32-release",
      "displayName": "ESP32 (release)",
      "cacheVariables": {
        "SDKCONFIG_DEFAULTS": "${sourceDir}/rcp/apps/esp32/sdkconfig.defaults.release"
      },
      "inherits": "_esp32"
    },
    {
      "name": "esp32-debug",
      "displayName": "ESP32 (debug)",
      "cacheVariables": {
        "SDKCONFIG_DEFAULTS": "${sourceDir}/rcp/apps/esp32/sdkconfig.defaults.debug"
      },
      "inherits": "_esp32"
    },
    {
      "name": "rpi-release",
      "displayName": "Raspberry Pi (release)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/rpi-release"
    },
    {
      "name": "rpi-debug",
      "displayName": "Raspberry Pi (debug)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/rpi-debug"
    }
  ],
  "buildPresets": [
    {
      "name": "esp32-release",
      "configurePreset": "esp32-release"
    },
    {
      "name": "esp32-debug",
      "configurePreset": "esp32-debug"
    },
    {
      "name": "rpi-release",
      "configurePreset": "rpi-release"
    },
    {
      "name": "rpi-debug",
      "configurePreset": "rpi-debug"
    }
  ]
}